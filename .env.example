DATABASE_URL=postgresql://user:password@localhost:5432/nodus
# Valores abaixo devem ser gerados/configurados antes de iniciar.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=https://seu-frontend.example
# IPs/CIDRs dos proxies efetivamente controlados; vazio nao confia em headers.
# Render publico validado: render-true-client-ip; local/outros: express.
CLIENT_IP_SOURCE=express
TRUSTED_PROXY_CIDRS=
# Diagnostico temporario de homologacao, exige JWT de ADMIN. Desativar apos teste.
ENABLE_PROXY_DIAGNOSTICS=false
APP_BASE_URL=https://sua-api.example
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
# Retencao: definir somente apos aprovacao do controlador.
MESSAGE_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=
CREATE_DEMO=false

# Unico usuario ADMIN autorizado a administrar todas as empresas. Vazio desativa.
# Use user.id retornado por /auth/me, NUNCA tenant.id. Apenas no backend.
PLATFORM_OWNER_USER_ID=

# Ativar somente apos deploy das migracoes e configuracao do agendador externo.
# Migra contratos ativos e aplica o calendario a novas assinaturas.
BILLING_CALENDAR_ENABLED=false
# Segredo aleatorio >=32 caracteres, igual no agendador Contabo. Nunca no frontend.
BILLING_RUN_TOKEN=

# Avisos das novas mensalidades: ativar apos configurar o Owner e o agendador.
BILLING_DELIVERY_ENABLED=false
# Reutiliza o Resend ja usado para convites/recuperacao de senha.
RESEND_API_KEY=
MAIL_FROM=
# Somente canal Meta: template aprovado com 4 parametros de corpo (empresa, valor, vencimento, link).
BILLING_WHATSAPP_TEMPLATE_NAME=
BILLING_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Fila persistente da API (ativar somente depois das migrations)
API_QUEUE_ENABLED=false
API_QUEUE_WORKER_ENABLED=false
# Token exclusivo para o runner externo no Contabo; minimo 32 caracteres
API_QUEUE_RUN_TOKEN=
# Limites por empresa (1..60). Upload = entrada; sends = processamento.
API_QUEUE_UPLOADS_PER_MINUTE=10
API_QUEUE_SENDS_PER_MINUTE=10
# Capacidade em MiB de payload criptografado; nao e cota mensal de mensagens
API_QUEUE_TENANT_MIB=128
API_QUEUE_TOTAL_MIB=256

# Emissao manual de teste no Owner: somente Asaas Sandbox
BILLING_SANDBOX_TEST_ENABLED=false
