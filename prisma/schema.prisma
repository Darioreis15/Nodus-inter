generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ChannelType {
  QR_EVOLUTION
  OFFICIAL_META
}

enum ChannelStatus {
  PENDING
  CONNECTED
  DISCONNECTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  OVERDUE
  CANCELED
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  maxChannels Int      @default(1)
  maxUsers    Int      @default(3)
  priceCents  Int      @default(0) @map("price_cents") // preco mensal em centavos (BRL)
  createdAt   DateTime @default(now())

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  planId    String       @map("plan_id")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  plan                 Plan                  @relation(fields: [planId], references: [id])
  users                User[]
  channels             Channel[]
  contacts             Contact[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  subscription         Subscription?

  @@map("tenants")
}

model User {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  name               String
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               UserRole @default(AGENT)
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  lockedUntil        DateTime? @map("locked_until")
  tokenVersion       Int @default(0) @map("token_version")
  failedLoginCount   Int      @default(0) @map("failed_login_count")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  assignedConversations Conversation[]

  @@index([tenantId])
  @@map("users")
}

model Channel {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  type       ChannelType
  name       String
  status     ChannelStatus @default(PENDING)
  externalId String?       @map("external_id")
  // QR_EVOLUTION: { instanceName, baseUrl }
  // OFFICIAL_META: { phoneNumberId, wabaId, accessToken }
  config     Json          @default("{}")
  autoReplyEnabled Boolean @default(false) @map("auto_reply_enabled")
  autoReplyMessage String? @map("auto_reply_message")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@unique([type, externalId])
  @@index([tenantId])
  @@map("channels")
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  legalHold Boolean @default(false) @map("legal_hold")
  waId      String   @map("wa_id") // numero de WhatsApp, sem formatacao (ex: 5531999999999)
  name      String?
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@unique([tenantId, waId])
  @@index([tenantId])
  @@map("contacts")
}

model Conversation {
  id             String             @id @default(uuid())
  channelId      String             @map("channel_id")
  contactId      String             @map("contact_id")
  assignedUserId String?            @map("assigned_user_id")
  status         ConversationStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id])
  assignedUser User?     @relation(fields: [assignedUserId], references: [id])
  messages     Message[]

  @@index([channelId])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  externalId     String?          @map("external_id")
  fromNumber     String           @map("from_number")
  toNumber       String           @map("to_number")
  body           String
  status         MessageStatus    @default(QUEUED)
  raw            Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([externalId])
  @@map("messages")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  name       String
  keyPrefix  String    @map("key_prefix") // primeiros caracteres, so pra identificar qual chave e qual nas listagens
  keyHash    String    @map("key_hash") // sha256 da chave real -- a chave crua nunca e guardada
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  url       String
  events    Json // array de strings, ex: ["message.received", "conversation.assigned"]
  secret    String // usado pra assinar o payload (HMAC-SHA256) e o cliente validar a origem
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

model Subscription {
  id                  String             @id @default(uuid())
  tenantId            String             @unique @map("tenant_id") // um tenant tem no maximo uma assinatura
  asaasCustomerId     String             @map("asaas_customer_id")
  asaasSubscriptionId String             @unique @map("asaas_subscription_id")
  status              SubscriptionStatus @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("subscriptions")
}

model RateBucket {
  key String @id
  hits Int
  expiresAt DateTime
  @@index([expiresAt])
  @@map("rate_buckets")
}
model AuditEvent {
  id String @id @default(uuid())
  tenantId String?
  actorId String?
  action String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("audit_events")
}
model ProviderEvent {
  id String @id
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("provider_events")
}
